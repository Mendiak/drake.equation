{
  "name": "drake.equation",
  "version": "1.0.0",
  "description": "Interactive Drake Equation calculator — estimate the number of communicative extraterrestrial civilizations in the Milky Way.",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "npm run build && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "build:es": "node scripts/generate-es.mjs",
    "build:content": "node scripts/generate-content.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint \"src/js/**/*.js\"",
    "lint:fix": "eslint \"src/js/**/*.js\" --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "check": "npm run lint && npm run lint:css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mendiak/drake.equation.git"
  },
  "keywords": [
    "drake-equation",
    "seti",
    "astrobiology",
    "milky-way",
    "exoplanets",
    "fermi-paradox",
    "threejs",
    "chartjs",
    "interactive",
    "visualization"
  ],
  "author": "Mikel Aramendia",
  "license": "CC0-1.0",
  "bugs": {
    "url": "https://github.com/Mendiak/drake.equation/issues"
  },
  "homepage": "https://mendiak.github.io/drake.equation/",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
